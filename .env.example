# Database
DATABASE_URL=sqlite+aiosqlite:///./face_attendance.db

# Runtime data directories
EMBED_DIR=data/embeddings
PHOTO_DIR=data/student_photos
UPLOAD_DIR=data/uploads
ACTIVE_LEARNING_DIR=data/active_learning
ACTIVE_LEARNING_EMBED_DIR=data/active_learning_embeddings

# Recognition and video processing
FACE_MATCH_THRESHOLD=0.50
VIDEO_TARGET_FPS=3
VIDEO_MIN_FRAMES=2
VIDEO_MAX_FRAMES=60
VIDEO_MAX_FRAME_DIMENSION=1920
VIDEO_PREVIEW_EVERY=3
MAX_VIDEO_UPLOAD_MB=250
